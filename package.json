{
  "name": "iskra",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "npm run build && node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "serve": "npm run build && python3 -m http.server 8781 --bind 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.type-tests.json",
    "build": "node scripts/build.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"type-tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"type-tests/**/*.ts\""
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "jsdom": "29.1.1",
    "prettier": "3.9.9",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
